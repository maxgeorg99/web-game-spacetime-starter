{
  "name": "rive-td",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/client.ts --target browser --outdir dist",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb --yes",
    "catalog": "bun scripts/catalog.ts && bun scripts/scene.ts",
    "rive:sign": "bun run catalog && bun scripts/sign.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p spacetimedb/tsconfig.json",
    "test": "bun test tests/game.test.ts",
    "test:multiplayer": "bun test tests/multiplayer.test.ts"
  },
  "dependencies": {
    "@rive-app/webgl2": "^2.44.0",
    "spacetimedb": "2.10.*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun": "^1.3.2",
    "typescript": "~5.6.2"
  }
}
