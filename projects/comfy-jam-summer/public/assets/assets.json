{
  "$schema": "Asset manifest — BootScene reads this and queues loads.",
  "spritesheets": [
    {
      "id": "beach-tiles",
      "keyPrefix": "tiles",
      "frameWidth": 32,
      "frameHeight": 32,
      "animations": [
        { "suffix": "sheet", "path": "sprites/terrain/beach_tiles.png", "endFrame": 179, "frameRate": 0, "repeat": 0 }
      ]
    },

    {
      "id": "turtle",
      "keyPrefix": "enemy-turtle",
      "frameWidth": 320,
      "frameHeight": 320,
      "animations": [
        { "suffix": "idle",   "path": "sprites/enemies/Turtle_Turtle_Idle.png",  "endFrame": 9, "frameRate": 6,  "repeat": -1 },
        { "suffix": "attack", "path": "sprites/enemies/Turtle_Turtle_Attack.png", "endFrame": 9, "frameRate": 12, "repeat": 0 },
        { "suffix": "death",  "path": "sprites/enemies/Turtle_Turtle_Death.png",  "endFrame": 5, "frameRate": 10, "repeat": 0 }
      ]
    },
    {
      "id": "snake",
