{
  "name": "tile-tower-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p spacetimedb --noEmit && tsc -p coordinator --noEmit",
    "test": "bun test tests/domain.test.ts tests/world.test.ts tests/i18n.test.ts tests/magic.test.ts",
    "test:server": "bun test tests/server.test.ts",
    "test:idc": "bun test tests/idc.test.ts",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb --yes",
    "idc:generate": "spacetime generate --bindings module --lang typescript --module-path coordinator --out-dir spacetimedb/src/remote_bindings/coordinator --yes",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && vite build",
    "server": "spacetime start --listen-addr 127.0.0.1:3106 --data-dir .local/spacetimedb --non-interactive",
    "server:publish": "spacetime publish tile-tower-defense-world --server http://127.0.0.1:3106 --module-path spacetimedb --yes",
    "coordinator:generate": "spacetime generate --lang typescript --out-dir src/coordinator_bindings --module-path coordinator --yes",
    "coordinator:publish": "spacetime publish tile-tower-defense-coordinator --server http://127.0.0.1:3106 --module-path coordinator --yes",
    "provisioner": "bun run scripts/provisioner.ts",
    "build:itch": "bun run typecheck && bun run scripts/build-itch.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "provisioner:maincloud": "bun --env-file=.env.provisioner run scripts/provisioner.ts",
    "secrets:github": "bun --env-file=.env.provisioner run scripts/configure-secrets.ts"
  },
  "dependencies": {
    "i18next": "^26.5.12",
    "phaser": "^3.90.0",
    "spacetimedb": "2.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.1.0"
  }
}
