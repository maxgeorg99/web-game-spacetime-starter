# Copy to .env.android-signing (ignored). Keep real values in a password manager.
# Relative keystore paths resolve from this project when using android:release.
ANDROID_KEYSTORE_PATH=.local/android-signing/upload.p12
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=
# Must increase after every uploaded release; never reuse a Play version code.
ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=0.1.0
